SAHAYAK_ENV=prod                      # prod refuses to start with dev secrets
DATABASE_URL=postgresql://user:pass@host:5432/sahayak
ADMIN_KEY=                            # long random string
JWT_SECRET=                           # python -c "import secrets;print(secrets.token_urlsafe(48))"
PEPPER=                               # python -c "import secrets;print(secrets.token_urlsafe(32))"
DATA_KEY=                             # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SMS_WEBHOOK_URL=                      # your SMS gateway adapter; receives {"to","message"}
SMS_WEBHOOK_TOKEN=
OTP_DEV_ECHO=0                        # 1 returns the OTP in the API response; development only
